generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Level {
  id        String   @id @default(uuid())
  data      Json
  // Posición explícita en la secuencia de juego (back#5): el seed curado
  // (back#10) necesita control de orden, no solo el de inserción.
  order     Int      @unique
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ScoreEntry {
  id          String   @id @default(uuid())
  userId      String
  levelId     String
  score       Int
  stars       Int
  moves       Int
  timeSeconds Int
  createdAt   DateTime @default(now())

  // Índice compuesto para la consulta del leaderboard: filtra por nivel y
  // ordena por score. userId/levelId son String sin FK (los niveles se siembran
  // en back#10 y pueden no existir aún al escribir en entornos de prueba).
  @@index([levelId, score])
}

model Progress {
  id         String   @id @default(uuid())
  userId     String
  levelId    String
  completed  Boolean
  bestScore  Int?
  bestStars  Int?
  updatedAt  DateTime @updatedAt

  // Un registro por (usuario, nivel): el sync hace upsert sobre esta clave,
  // nunca inserta duplicados para el mismo par.
  @@unique([userId, levelId])
}
