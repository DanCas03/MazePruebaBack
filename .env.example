# PostgreSQL connection string in Prisma format — REQUIRED
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Secret used to sign and verify JWTs — REQUIRED
JWT_SECRET="your-secret-key"

# Token lifespan for the persistent client session (e.g. 7d, 30d, 12h).
# Long-lived by design so the mobile client stays logged in across launches.
# Optional — defaults to 7d when unset.
JWT_EXPIRATION="7d"

# HTTP port — optional, defaults to 3000
PORT=3000
